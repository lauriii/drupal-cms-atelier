{
    "name": "drupal/nebula",
    "description": "A Drupal CMS site template for authoring Drupal Canvas code components with a Nebula codebase.",
    "type": "drupal-recipe",
    "license": [
        "GPL-2.0-or-later"
    ],
    "require": {
        "drupal/canvas": "^1.2",
        "drupal/drupal_cms_site_template_base": "^2",
        "drupal/jsonapi_menu_items": "^1.2",
        "drupal/jsonapi_search_api": "^1.0@RC",
        "drupal/search_api": "^1.39",
        "drupal/simple_oauth": "^6"
    },
    "extra": {
        "drupal-site-template": {
            "generate-theme": {
                "name": "nebula_theme",
                "from": false,
                "info": {
                    "name": "Nebula",
                    "description": "A blank shell theme. It renders the Canvas component tree and nothing else; all styling comes from the code components pushed by the Canvas CLI.",
                    "regions": {
                        "header": "Header",
                        "content": "Content",
                        "footer": "Footer"
                    },
                    "libraries-override": {
                        "system/base": false
                    }
                }
            }
        }
    }
}
